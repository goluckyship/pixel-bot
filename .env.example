# Pixel Bot's secret settings. Copy this file, name the copy  .env  and fill it in.
# Never share these values or upload this file anywhere public.
#
# Required: the bot's token (Developer Portal → Bot → Reset Token).
# On your PC you can skip this: the bot asks for it the first time it starts.
DISCORD_TOKEN=paste-your-token-here

# Optional: the web dashboard. Leave these empty to keep it off.
# DASHBOARD_URL is the address people open, e.g. http://node.wispbyte.com:1234
# DISCORD_CLIENT_SECRET is from Developer Portal → OAuth2 → Client Secret.
# Also add  DASHBOARD_URL/callback  under Developer Portal → OAuth2 → Redirects.
DASHBOARD_URL=
DISCORD_CLIENT_SECRET=
